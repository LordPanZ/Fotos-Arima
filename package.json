{
  "name": "fotos-arima",
  "version": "1.0.0",
  "private": true,
  "description": "Catalogo de manualidades: importa fotos de Google Fotos, las clasifica por tipo de manualidad, las renombra y las comparte. PWA instalable en movil y PC.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dev": "npm run build && npm --prefix desktop run start",
    "desktop:build": "npm run build && npm --prefix desktop run dist",
    "smoke": "node scripts/smoke.mjs",
    "verificar-pwa": "node scripts/verificar-pwa.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-pwa": "^0.21.1"
  }
}
